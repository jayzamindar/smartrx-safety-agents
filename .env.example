# ==============================================================================
# SmartRx Safety Agents — Environment Configuration Template
# ==============================================================================
# Copy to .env (never commit .env to version control):
#   Linux/macOS: cp .env.example .env
#   Windows:     Copy-Item .env.example .env
# ==============================================================================

# AI Reasoning Engines
GEMINI_MODEL_NAME=gemini-3.8-flash-high
GEMINI_API_KEY=
GEMINI_THINKING_BUDGET=2048
MAX_OUTPUT_TOKENS=8192
OPENROUTER_API_KEY=

# Security, Authentication & Cryptographic Signing
ENVIRONMENT=development
REQUIRE_AUTH=false
MCP_API_KEY=
PLAN_SIGNING_SECRET=
SMARTRX_SAFETY_AGENTS_WEBHOOK_SECRET=

# Server & Transport Limits
SMARTRX_PORT=8080
MAX_PAYLOAD_SIZE_BYTES=10485760

# Persistence & Audit Logs
SMARTRX_DB_PATH=data/smartrx_ledger.db
AUDIT_LOG_DIR=audit_logs/
FILELOCK_TIMEOUT_SEC=10.0

# Cost & Token Circuit Breakers
MAX_SESSION_TOKEN_BUDGET=500000
DAILY_API_COST_LIMIT_USD=10.00
